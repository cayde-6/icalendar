{
  "name": "@cayde-6/icalendar",
  "version": "0.3.0",
  "description": "TypeScript CLI for CalDAV calendars, iCalendar events, and automation workflows",
  "type": "module",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "icalendar": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bash -lc 'node --import tsx --test $(find test -name \"*.test.ts\" -print)'",
    "test:coverage": "bash -lc 'c8 --reporter=text --reporter=lcov node --import tsx --test $(find test -name \"*.test.ts\" -print)'",
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run check && npm run build && npm run test:coverage",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cayde-6/icalendar.git"
  },
  "keywords": [
    "caldav",
    "icalendar",
    "ics",
    "cli",
    "automation",
    "workflow",
    "icloud"
  ],
  "author": {
    "name": "cayde-6",
    "url": "https://github.com/cayde-6"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cayde-6/icalendar/issues"
  },
  "homepage": "https://github.com/cayde-6/icalendar#readme",
  "dependencies": {
    "cac": "^6.7.14",
    "dotenv": "^17.4.2",
    "tsdav": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
