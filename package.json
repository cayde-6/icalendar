{
  "name": "icalendar",
  "version": "0.1.0",
  "description": "TypeScript toolkit for working with CalDAV calendars and iCalendar data",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cayde-6/icalendar.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cayde-6/icalendar/issues"
  },
  "homepage": "https://github.com/cayde-6/icalendar#readme",
  "private": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "dependencies": {
    "dotenv": "^17.4.2",
    "tsdav": "^2.2.0",
    "zod": "^4.4.1",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "tsup": "^8.5.0"
  },
  "bin": {
    "icalendar": "./dist/cli.js"
  }
}
